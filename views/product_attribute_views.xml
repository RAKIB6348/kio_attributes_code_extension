<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_attribute_form_view_inherit_kio_value_code" model="ir.ui.view">
        <field name="name">product.attribute.form.inherit.kio.value.code</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_ids']/tree/field[@name='name']" position="after">
                <field name="value_code"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_attribute_value_view_tree_inherit_kio_value_code" model="ir.ui.view">
        <field name="name">product.template.attribute.value.tree.inherit.kio.value.code</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="value_code"/>
            </xpath>
        </field>
    </record>
</odoo>